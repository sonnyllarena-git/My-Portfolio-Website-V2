# Local-only admin portal config — copy this file to backend/.env (gitignored) and fill in real
# values. These are mock credentials for local practice, not real auth — see LESSONS.md before
# this ever goes public.
#
# For a Vercel deployment, every variable below (except PORT, which Vercel ignores) must
# also be added in the Vercel project's Settings > Environment Variables.
PORT=4000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Postgres — use Supabase's "Transaction" pooler connection string (port 6543), not the
# direct connection string, so serverless invocations don't exhaust the connection limit.
DATABASE_URL=

# Supabase Storage (Music Lab uploads, product/project photos) — S3-compatible API.
SUPABASE_URL=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_BUCKET_NAME=

# Resend — real email notification when a visitor submits the Gmail Contact Inquiry form.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
