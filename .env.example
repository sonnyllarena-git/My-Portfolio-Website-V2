# Database connection (required for Express backend)
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://localhost/portfolio_dev

# Backend port (optional, defaults to 4000)
PORT=4000

# Vite only exposes vars prefixed with VITE_ to the client bundle — anyone can read them in the
# shipped JS. Never put a real secret behind that prefix. Non-prefixed vars are invisible to
# the browser and safe for backend secrets.

# Admin login (required — backend/routes/auth.js refuses to start without both).
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# Resend (email API) — sends you a notification whenever a visitor submits the Gmail app's
# "Inquiry" form. Free tier: 100 emails/day, no card required. Get RESEND_API_KEY from
# resend.com > API Keys. Without a verified custom domain, RESEND_FROM_EMAIL must stay
# onboarding@resend.dev and RESEND_TO_EMAIL must match the email you signed up to Resend with.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=your-email@example.com

# Supabase Storage (S3-compatible object storage) — backs Music Lab admin uploads (video/audio).
# Free tier: 1GB storage, 2GB egress/month, no card required. SUPABASE_URL is the project URL
# (Project Settings > Data API). The rest come from the bucket's own Storage > S3 (sidebar under
# CONFIGURATION) page — Endpoint, Region, and a generated access key pair (New access key button).
# Note the S3 endpoint uses a different subdomain (*.storage.supabase.co) than the project URL
# (*.supabase.co) — copy it exactly rather than deriving it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=your-project-region
SUPABASE_S3_ACCESS_KEY_ID=your-supabase-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-supabase-s3-secret-access-key
SUPABASE_BUCKET_NAME=your-bucket-name
