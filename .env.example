# Database connection (required for Express backend)
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://localhost/portfolio_dev

# Backend port (optional, defaults to 4000)
PORT=4000

# Vite only exposes vars prefixed with VITE_ to the client bundle — anyone can read them in the
# shipped JS. Never put a real secret behind that prefix. Non-prefixed vars are invisible to
# the browser and safe for backend secrets.

# Cloudflare R2 (S3-compatible object storage) — backs Music Lab admin uploads (video/audio).
# Free tier: 10GB storage, zero egress fees. Get these from the Cloudflare dashboard: R2 > your
# bucket > Settings (for the public URL) and R2 > Manage API Tokens (for the key pair).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
